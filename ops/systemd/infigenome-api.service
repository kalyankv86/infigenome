# /etc/systemd/system/infigenome-api.service
[Unit]
Description=Infigenome API (Fastify)
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=simple
User=infigenome
WorkingDirectory=/opt/infigenome/apps/api
Environment=NODE_ENV=production
Environment=PORT=4000
EnvironmentFile=/opt/infigenome/apps/api/.env
ExecStart=/usr/bin/node dist/server.js
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
