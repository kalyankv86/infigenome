# /etc/systemd/system/infigenome-api.service
[Unit]
Description=Infigenome API (Fastify)
After=network.target mysql.service
Wants=mysql.service

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/opt/infigenome/apps/api
EnvironmentFile=/opt/infigenome/apps/api/.env
ExecStart=/usr/bin/node /opt/infigenome/apps/api/dist/server.js
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
